{
  // Markdownlint configuration for RateTick Studio participant docs
  // See: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md

  "default": true,

  // Disable line length limit for documentation (often has long URLs and tables)
  "MD013": false,

  // Allow fenced code blocks without surrounding blank lines
  "MD031": false,

  // Allow lists without surrounding blank lines (common in documentation)
  "MD032": false,

  // Allow inline HTML img tags for screenshots and diagrams
  "MD033": {
    "allowed_elements": ["img", "details", "summary", "b", "code"]
  },

  // Allow first line to not be a top-level heading (files may start with metadata or intro text)
  "MD041": false
}
